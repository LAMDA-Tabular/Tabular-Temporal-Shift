{
    "ftt_temporal": {
        "model": {
            "n_layers": ["int", 1, 4],
            "d_token": ["$power_int", 5, 8],
            "attention_dropout": ["uniform", 0.0, 0.5],
            "ffn_dropout": ["uniform", 0.0, 0.5],
            "temporal_embeddings": {
                "order": ["$temporal_order", 4, 1, 7],
                "trend": ["categorical", [true, false]],
                "d_embedding": ["$power_int", 1, 5]
            }
        },
        "training": {
            "lr": ["loguniform", 1e-05, 0.001],
            "weight_decay": ["?loguniform", 0.0, 1e-06, 0.001]
        },
        "general": {}
    }
}