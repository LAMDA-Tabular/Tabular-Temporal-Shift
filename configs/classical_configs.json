{
    "dataset": "Bank_Customer_Churn_Dataset",
    "model_type": "xgboost",
    "normalization": "standard",
    "num_nan_policy": "mean",
    "cat_nan_policy": "new",
    "cat_policy": "ohe",
    "num_policy": "none",
    "temporal_policy": "indices",
    "n_bins": 2,
    "cat_min_frequency": 0.0,
    "n_trials": 100,
    "seed_num": 15,
    "gpu": "0",
    "tune": false,
    "retune": false,
    "enable_timestamp": false,
    "evaluate_option": "best-val",
    "validate_option": "holdout_last",
    "hpo_timeout": 86400,
    "dataset_path": "data",
    "dataset_path_tabred": "data_tabred",
    "model_path": "results_model"
}
